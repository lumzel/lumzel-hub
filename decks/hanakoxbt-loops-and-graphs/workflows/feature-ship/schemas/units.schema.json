{
  "type": "object",
  "title": "交付单元拆分",
  "required": ["units"],
  "properties": {
    "fullCheckCmd": { "type": "string", "title": "全量检查命令", "x-lumzel": {"view": "code"} },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "checkFiles", "checkCmd", "prompt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "title": "目标" },
          "mode": { "type": "string", "enum": ["tdd", "verify"], "title": "模式", "x-lumzel": {"view": "badge"} },
          "checkFiles": { "type": "array", "items": {"type": "string"}, "title": "检查文件" },
          "implFiles": { "type": "array", "items": {"type": "string"}, "title": "实现文件" },
          "checkCmd": { "type": "string", "minLength": 1, "title": "检查命令", "x-lumzel": {"view": "code"} },
          "prompt": { "type": "string", "minLength": 1, "title": "提示词" }
        }
      },
      "title": "交付单元",
      "x-lumzel": { "view": "cards" }
    }
  }
}
