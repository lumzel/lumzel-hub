    {
      "id": "everything-claude-code",
      "mode": "suite",
      "repo": "affaan-m/everything-claude-code",
      "skills": {
        "mode": "dir",
        "path": "skills"
      },
      "agents": {
        "mode": "dir",
        "path": "agents"
      },
      "rules": {
        "mode": "lang-dirs",
        "path": "rules",
        "prefix": "ecc-",
        "excludeDirs": [
          "zh"
        ]
      },
      "mcp": {
        "mode": "mcp-servers-json",
        "source": "mcp-configs/mcp-servers.json"
      },
      "instructions": {
        "source": "AGENTS.md"
      },
      "preserve": [
        "hooks"
      ]
    },
    {
      "id": "matt-pocock",
      "mode": "suite",
      "repo": "mattpocock/skills",
      "skills": {
        "mode": "buckets",
        "path": "skills",
        "buckets": [
          "engineering",
          "productivity",
          "misc",
          "in-progress"
        ]
      },
      "instructions": {
        "source": "AGENTS.md",
        "header": "# Matt Pocock Engineering & Planning Workflow\n\nUse `grill-me` / `grill-with-docs` to stress-test requirements before design, `domain-modeling` and `codebase-design` to shape deep modules, `to-spec` and `to-tickets` to slice tracer-bullet deliverables, `tdd` to test at public seams, and `code-review` to audit changes along Standards + Spec axes.\n\n"
      },
      "preserve": [
        "agents",
        "rules"
      ]
    },
    {
      "id": "superpowers",
      "mode": "suite",
      "repo": "obra/superpowers",
      "skills": {
        "mode": "dir",
        "path": "skills"
      },
      "preserve": [
        "agents",
        "hooks",
        "rules",
        "AGENTS.md"
      ]
    },
    {
      "id": "spec-kit",
      "mode": "suite",
      "repo": "github/spec-kit",
      "skills": {
        "mode": "commands-to-skills",
        "commandsDir": "templates/commands",
        "prefix": "speckit-",
        "templatesDir": "templates"
      },
      "rules": {
        "mode": "single-file",
        "source": "spec-driven.md",
        "target": "speckit-sdd-principles",
        "description": "GitHub Spec-Kit Specification-Driven Development (SDD) principles and phase gates."
      },
      "preserve": [
        "agents",
        "AGENTS.md"
      ]
    },
    {
      "id": "compound-engineering",
      "mode": "suite",
      "repo": "EveryInc/compound-engineering-plugin",
      "skills": {
        "mode": "dir",
        "path": "skills"
      },
      "agents": {
        "mode": "nested-skill-agents",
        "skillsDir": "skills",
        "prefix": "ce-"
      },
      "rules": {
        "mode": "single-file",
        "source": "CODING_STANDARDS.md",
        "target": "ce-coding-standards",
        "description": "EveryInc Compound Engineering coding standards and maintainability guidelines."
      },
      "instructions": {
        "source": "AGENTS.md"
      }
    },
    {
      "id": "gstack",
      "mode": "suite",
      "repo": "garrytan/gstack",
      "skills": {
        "mode": "root-scan"
      },
      "rules": {
        "mode": "single-file",
        "source": "ETHOS.md",
        "target": "gstack-ethos",
        "description": "Garry Tan gstack Boil-the-Lake engineering ethos and shipping principles."
      },
      "preserve": [
        "agents",
        "AGENTS.md"
      ]
    }
